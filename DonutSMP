<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Donut SMP Map Arts</title>
  <style>
    :root {
      --bg: #0f172a;
      --card: #1e293b;
      --accent: #f59e0b;
      --text: #e5e7eb;
      --muted: #94a3b8;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Segoe UI', Tahoma, sans-serif;
      background: radial-gradient(circle at top, #1e293b, #020617);
      color: var(--text);
    }

    header {
      padding: 3rem 1rem;
      text-align: center;
      background: linear-gradient(135deg, #1e293b, #020617);
      border-bottom: 3px solid var(--accent);
    }

    header h1 {
      font-size: 2.5rem;
      color: var(--accent);
      text-shadow: 0 0 10px rgba(245,158,11,.4);
    }

    header p {
      margin-top: 1rem;
      color: var(--muted);
    }

    section {
      max-width: 1200px;
      margin: 3rem auto;
      padding: 0 1rem;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 1.5rem;
    }

    .card {
      background: var(--card);
      border-radius: 12px;
      overflow: hidden;
      border: 2px solid #334155;
      transition: transform .2s, box-shadow .2s;
    }

    .card:hover {
      transform: translateY(-5px);
      box-shadow: 0 10px 30px rgba(0,0,0,.4);
      border-color: var(--accent);
    }

    .card img {
      width: 100%;
      height: 200px;
      object-fit: cover;
      background: #020617;
    }

    .card-content {
      padding: 1rem;
    }

    .card-content h3 {
      color: var(--accent);
      margin-bottom: .5rem;
    }

    .price {
      font-weight: bold;
      margin-top: .5rem;
    }

    .about {
      background: rgba(30,41,59,.6);
      padding: 2rem;
      border-radius: 12px;
      border: 2px dashed #334155;
    }

    footer {
      text-align: center;
      padding: 2rem 1rem;
      color: var(--muted);
      border-top: 2px solid #1e293b;
    }

    .owners {
      color: var(--accent);
      font-weight: bold;
    }
  </style>
</head>
<body>

<header>
  <h1>🍩 Donut SMP Map Arts</h1>
  <p>Custom map arts for Donut SMP and Minecraft</p>
</header>

<section class="about">
  <h2>Who are we?</h2>
  <p style="margin-top:1rem;">
    We are <span class="owners">mates335</span> and <span class="owners">Lingowks13</span>, creators of
    <strong>exclusive map arts</strong> for Minecraft servers, especially Donut SMP.
  </p>
  <p style="margin-top:.5rem; color: var(--muted);">
    Each design is made with precision, creativity, and love for Minecraft.
  </p>
</section>

<section>
  <h2 style="margin-bottom:1.5rem;">🗺️ Our Map Arts</h2>

  <!-- EDIT THIS SECTION TO ADD MAP ARTS -->
  <div class="grid">

    <div class="card">
      <img src="imagenes/mapart1.png" alt="Map Art 1">
      <div class="card-content">
        <h3>Donut SMP Map Art</h3>
        <p>Design inspired by Donut SMP.</p>
        <div class="price">Price: €10</div>
      </div>
    </div>

    <div class="card">
      <img src="imagenes/mapart2.png" alt="Map Art 2">
      <div class="card-content">
        <h3>Custom Logo</h3>
        <p>Perfect for bases or shops.</p>
        <div class="price">Price: €15</div>
      </div>
    </div>

    <!-- DUPLICATE THESE CARDS FOR MORE MAP ARTS -->

  </div>
</section>

<section class="about">
  <h2>📩 Contact</h2>
  <p style="margin-top:1rem;">
    For orders or information, contact us on Discord or inside Donut SMP.
  </p>
</section>

<footer>
  <p>© 2026 Donut SMP Map Arts</p>
  <p>Made by <span class="owners">mates335</span> & <span class="owners">Lingowks13</span></p>
</footer>

</body>
</html>
